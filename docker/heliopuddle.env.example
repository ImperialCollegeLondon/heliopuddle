# Settings for the heliopuddle container. Copy to docker/heliopuddle.env (used by
# docker/compose.yaml and docker/compose.external.yaml) or pass with
# `docker run --env-file`. Every setting is optional: the image works with none.
# See docs/design/deployment.md.

# --- Database ------------------------------------------------------------------
# Default: SQLite at /var/lib/heliopuddle/heliopuddle.db (the state volume).
# HELIOPUDDLE_DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/heliopuddle

# --- Prefect -------------------------------------------------------------------
# Default: an embedded Prefect server on port 4200.
# PREFECT_API_URL=https://prefect.example/api
# HELIOPUDDLE_PREFECT_UI_URL=https://prefect.example

# --- Authentication ------------------------------------------------------------
# Default: local users; the first admin's password is logged once at first start.
# HELIOPUDDLE_ADMIN_USERNAME=admin
# HELIOPUDDLE_ADMIN_PASSWORD=change-me-at-least-12-chars
# Several heliopuddle processes must share one signing key:
# HELIOPUDDLE_AUTH_SECRET_KEY=a-long-random-string

# OIDC (for example Keycloak) instead of local users:
# HELIOPUDDLE_AUTH_MODE=oidc
# HELIOPUDDLE_OIDC_ISSUER=https://keycloak.example/realms/heliopuddle
# HELIOPUDDLE_OIDC_CLIENT_ID=heliopuddle
# HELIOPUDDLE_OIDC_CLIENT_SECRET=client-secret-from-keycloak

# Behind a proxy that authenticates users and sets a trusted header:
# HELIOPUDDLE_AUTH_MODE=header
# HELIOPUDDLE_USER_HEADER=X-Forwarded-User

# --- Files and projects --------------------------------------------------------
# Project YAML directory (default /config, holding an example project).
# HELIOPUDDLE_CONFIG_DIR=/config
# Largest CDF copied to a temporary file for a preview from remote storage.
# HELIOPUDDLE_PREVIEW_MAX_BYTES=1GB
